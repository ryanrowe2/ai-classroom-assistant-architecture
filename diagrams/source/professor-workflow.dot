digraph ClassroomProfessorFlow {
  graph [rankdir=TB, bgcolor="white", pad="0.34", nodesep="0.44", ranksep="0.63", label="PROFESSOR • CLASSROOM SETUP AND INDEPENDENT OPERATIONS\nConceptual reconstruction • not verified application screens", labelloc="t", fontsize=19, fontname="Arial", fontcolor="#203a5d", splines=polyline];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12.2, margin="0.22,0.16", color="#8ea6c6", fillcolor="#edf4ff", fontcolor="#183453", penwidth=1.3];
  edge [color="#607890", arrowsize=0.67, penwidth=1.3, fontname="Arial", fontsize=10.2, fontcolor="#42566d"];

  start [label="Professor signs in", fillcolor="#daebff"];
  gate [shape=diamond, label="Authorized professor?", fillcolor="#fff2dd"];
  deny [label="Deny access\n(no mutation)", fillcolor="#fff0ee", color="#d89991"];
  choose [shape=diamond, label="Open existing class\nor create new?", fillcolor="#fff2dd"];
  create [label="Create one owned class\n(R18)"];
  initial [shape=diamond,label="Add initial\ncourse materials?",fillcolor="#fff2dd"];
  add [label="Populate class with\ninitial resources\n(optional)"];
  empty [label="Choose skip upload (R10)\nClass contains zero files",fillcolor="#e8f7ed",color="#91bda2"];
  existing [label="Select authorized\nexisting class"];
  admin [label="Class dashboard\nOne owned class exists", fillcolor="#d9e9ff"];
  operations [label="Independent optional class operations\nPerform any needed action, in any order", fillcolor="#eff2f8"];
  outlines [label="Save outline / topics\n(R07, R09)"];
  resources [label="Manage course materials\nand exam/quiz data\n(R06, R08)"];
  downloads [label="Download existing\ntests/homework/essays\n(R11)"];
  code [label="Issue unique join code\nif student enrollment needed\n(R03)",fillcolor="#e8f7ed",color="#91bda2"];
  join [label="Students can later use\ncode to enroll (R04–R05)",fillcolor="#f2f5f8"];

  start -> gate;
  gate -> deny [label="no"];
  gate -> choose [label="yes"];
  choose -> create [label="new"];
  choose -> existing [label="existing"];
  create -> initial;
  initial -> add [label="yes"];
  initial -> empty [label="no"];
  {rank=same; add; empty; existing}
  add -> admin;
  empty -> admin;
  existing -> admin;
  admin -> operations;
  {rank=same; outlines; resources; downloads; code}
  operations -> outlines [label="optional"];
  operations -> resources [label="optional"];
  operations -> downloads [label="optional"];
  operations -> code [label="optional"];
  code -> join [label="only if issued"];
  {rank=same; join}
}
